{
  "name": "opencode-profile-switcher",
  "version": "2.1.0",
  "description": "Switch OpenCode config profiles live from the TUI or the desktop app — no config edits, no restart",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": ["src", "dist"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "vite build",
    "check": "bun run typecheck && bun run build && bun test"
  },
  "keywords": ["opencode", "opencode-plugin", "profile", "config", "tui", "desktop"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pasei-dev/opencode-profile-switcher.git"
  },
  "bugs": {
    "url": "https://github.com/pasei-dev/opencode-profile-switcher/issues"
  },
  "homepage": "https://github.com/pasei-dev/opencode-profile-switcher#readme",
  "dependencies": {
    "@opencode/plugin": "^2.3.0",
    "@opencode/schema": "^2.3.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.1",
    "@opentui/solid": ">=0.8.1",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opentui/core": "^0.8.1",
    "@opentui/solid": "^0.8.1",
    "@types/bun": "^1.2.20",
    "@types/node": "^26.5.1",
    "solid-js": "^1.9.19",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "vite-plugin-solid": "^2.11.10"
  }
}
